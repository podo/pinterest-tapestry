{
  "id": "io.github.podo.pinterest.account",
  "display_name": "Pinterest",
  "service_name": "Pinterest",
  "default_color": "coral",
  "icon": "https://www.pinterest.com/favicon.ico",
  "item_style": "post",
  "site": "https://api.pinterest.com",
  "oauth_authorize": "https://www.pinterest.com/oauth/",
  "oauth_token": "https://api.pinterest.com/v5/oauth/token",
  "oauth_type": "code",
  "oauth_code_key": "code",
  "oauth_scope": "boards:read,pins:read,user_accounts:read",
  "oauth_grant_type": "authorization_code",
  "oauth_basic_auth": true,
  "oauth_http_redirect": true,
  "needs_api_keys": true,
  "needs_verification": true,
  "verify_variables": true,
  "provides_attachments": true,
  "synchronizable_credentials": false,
  "minimum_app_version": "1.3",
  "version": 1
}
